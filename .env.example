NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
# Public base URL of the API (no path) - used to build the SSO/OIDC callback URL
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nexora
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
DOCUMENT_MAX_SIZE_BYTES=26214400
JWT_ACCESS_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_CONSOLE_ENABLED=false
EXPOSE_PASSWORD_RESET_TOKEN=false

# Billing (Stripe) — leave empty for self-hosted mode (plan changes apply directly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON map of plan code + billing cycle to Stripe Price IDs
# STRIPE_PRICE_MAP={"professional:MONTHLY":"price_xxx","professional:ANNUAL":"price_yyy","business:MONTHLY":"price_zzz"}
STRIPE_PRICE_MAP=

# AI provider — "local" (rule-based, default) or "openai" (OpenAI-compatible Chat Completions)
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Free alternatives (OpenAI-compatible):
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=openai/gpt-oss-120b
#   Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1       OPENAI_MODEL=qwen2.5:7b  OPENAI_API_KEY=ollama
#   Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.0-flash
